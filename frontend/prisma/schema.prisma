generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      Role     @default(USER)
  credits   Float    @default(5.0)
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id           String    @id @default(cuid())
  fileName     String
  fileSize     Int?
  audioUrl     String?
  status       JobStatus @default(QUEUED)
  model        String    @default("whisper-large-v3-turbo")
  stages       String[]  @default(["transcribe", "summary", "keywords"])
  currentStage String?   @default("queued")
  duration     Float     @default(0)
  processingMs Int?      @default(0)
  transcript   String?   @db.Text
  summary      String?   @db.Text
  keywords     String[]  @default([])
  sentiment    String?
  errorMessage String?
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}